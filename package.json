{
  "name": "credixa",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @credixa/db drizzle-kit generate",
    "db:push": "pnpm --filter @credixa/db drizzle-kit push",
    "db:studio": "pnpm --filter @credixa/db drizzle-kit studio",
    "auth:generate": "pnpm --filter @credixa/auth exec better-auth generate"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  }
}
